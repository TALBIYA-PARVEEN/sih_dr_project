# ==============================================================================
# NETRA-AI MONGODB ATLAS ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. MongoDB Atlas Connection URI (From MongoDB Atlas Dashboard)
# Example: mongodb+srv://sih_admin:your_password@cluster0.abcde.mongodb.net/dr_screening_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://sih_admin:your_password@cluster0.abcde.mongodb.net/dr_screening_db?retryWrites=true&w=majority
MONGO_DB_NAME=dr_screening_db

# 2. Secret Keys
SECRET_KEY=sih_dr_telemedicine_screening_secret_2026
JWT_SECRET_KEY=sih_jwt_super_secret_key_2026

# 3. Master Admin Account (Only 1 Admin)
ADMIN_EMAIL=admin@teleophta.org
ADMIN_PASSWORD=Admin@SIH2026
ADMIN_NAME=Master District Admin

# 4. Google OAuth 2.0 Client ID (From Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# 5. Email / SMTP Configuration for OTPs (Optional - e.g. Gmail App Password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_gmail_app_password
